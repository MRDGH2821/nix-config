# ls/ll/la come from programs.eza Zsh integration.
{
  home.shellAliases = {
    cat = "bat --paging=never";
    dir = "dir --color=auto";
    egrep = "egrep --color=auto";
    fgrep = "fgrep --color=auto";
    grep = "grep --color=auto";
    tb = "nc termbin.com 9999";
    tf = "touchfile";
    vdir = "vdir --color=auto";
  };
}
